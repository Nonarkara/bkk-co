{
  "version": 8,
  "name": "PL;UB manga",
  "metadata": {
    "register": "manga line-and-tone reference",
    "basis": "OpenMapTiles vector schema as served by OpenFreeMap — the same source and the same attributes the civic daylight basemap reads. No second data source, no extra network call.",
    "inspired_by": "Rokehan line-and-tone study (tools.oyasumi-gamedev.com). Original PL;UB implementation: no code, geometry or asset was copied from that tool.",
    "tone": "Screentone textures are drawn at runtime and added to the map image registry. Their ids are manga-tone-dot, manga-tone-hatch, manga-tone-water and manga-tone-shade.",
    "law": "A line here states a mapped fact. No layer may imply a height, an entrance, a footpath or a popularity the source does not carry."
  },
  "layers": [
    { "id": "manga-ground", "type": "background", "paint": { "background-color": "#faf9f5" } },

    { "id": "manga-park", "type": "fill", "source": "openmaptiles", "source-layer": "park",
      "filter": ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false],
      "paint": { "fill-pattern": "manga-tone-dot", "fill-opacity": 0.62 } },

    { "id": "manga-landcover", "type": "fill", "source": "openmaptiles", "source-layer": "landcover", "minzoom": 10,
      "filter": ["all",
        ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false],
        ["match", ["get", "class"], ["wood", "grass", "sand", "shrub"], true, false]],
      "paint": { "fill-pattern": "manga-tone-dot", "fill-opacity": 0.42 } },

    { "id": "manga-landuse", "type": "fill", "source": "openmaptiles", "source-layer": "landuse", "maxzoom": 16,
      "filter": ["all",
        ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false],
        ["match", ["get", "class"], ["cemetery", "allotments", "village_green", "meadow", "farmland", "wood"], true, false]],
      "paint": { "fill-pattern": "manga-tone-hatch", "fill-opacity": 0.3 } },

    { "id": "manga-town", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["all",
        ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false],
        ["==", ["get", "class"], "residential"]],
      "paint": { "fill-pattern": "manga-tone-hatch", "fill-opacity": 0.14 } },

    { "id": "manga-water", "type": "fill", "source": "openmaptiles", "source-layer": "water",
      "filter": ["all",
        ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false],
        ["!=", ["get", "brunnel"], "tunnel"]],
      "paint": { "fill-pattern": "manga-tone-water", "fill-opacity": 0.45 } },

    { "id": "manga-water-line", "type": "line", "source": "openmaptiles", "source-layer": "waterway",
      "filter": ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
      "paint": { "line-color": "#8f9aa4", "line-width": ["interpolate", ["exponential", 1.3], ["zoom"], 11, 0.5, 18, 2.2], "line-opacity": 0.8 } },

    { "id": "manga-building", "type": "fill", "source": "openmaptiles", "source-layer": "building", "minzoom": 13,
      "filter": ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false],
      "paint": { "fill-color": "#ffffff", "fill-opacity": 0.92 } },

    { "id": "manga-building-tone", "type": "fill", "source": "openmaptiles", "source-layer": "building", "minzoom": 14,
      "filter": ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false],
      "paint": { "fill-pattern": "manga-tone-shade", "fill-opacity": 0.5 } },

    { "id": "manga-building-line", "type": "line", "source": "openmaptiles", "source-layer": "building", "minzoom": 13,
      "paint": { "line-color": "#2b2320", "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 13, 0.35, 18, 1.15], "line-opacity": 0.72 } },

    { "id": "manga-road-major-casing", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 10,
      "filter": ["all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary"], true, false]],
      "paint": { "line-color": "#2b2320", "line-width": ["interpolate", ["exponential", 1.3], ["zoom"], 10, 3.4, 16, 12, 20, 30], "line-opacity": 0.82 } },

    { "id": "manga-road-major-core", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 10,
      "filter": ["all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary"], true, false]],
      "paint": { "line-color": "#faf9f5", "line-width": ["interpolate", ["exponential", 1.3], ["zoom"], 10, 1.5, 16, 8.6, 20, 25] } },

    { "id": "manga-road-minor", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 12,
      "filter": ["all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["match", ["get", "class"], ["minor", "service", "track", "raceway"], true, false]],
      "paint": { "line-color": "#3a322c", "line-width": ["interpolate", ["exponential", 1.55], ["zoom"], 13, 0.8, 18, 4, 20, 9], "line-opacity": 0.6 } },

    { "id": "manga-road-path", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 14,
      "filter": ["all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["match", ["get", "class"], ["path", "track", "pier", "busway", "bus_guideway"], true, false]],
      "paint": { "line-color": "#5a5148", "line-width": ["interpolate", ["linear"], ["zoom"], 14, 0.5, 20, 1.9], "line-dasharray": [3, 2.2], "line-opacity": 0.66 } },

    { "id": "manga-rail", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["==", ["get", "class"], "rail"]],
      "paint": { "line-color": "#6b6258", "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.6, 18, 2], "line-dasharray": [6, 3], "line-opacity": 0.62 } },

    { "id": "manga-water-label", "type": "symbol", "source": "openmaptiles", "source-layer": "water_name", "minzoom": 11,
      "layout": { "text-field": ["case", ["has", "name:nonlatin"], ["concat", ["get", "name:latin"], " ", ["get", "name:nonlatin"]], ["coalesce", ["get", "name_en"], ["get", "name"]]], "text-font": ["Noto Sans Italic"], "text-size": ["interpolate", ["linear"], ["zoom"], 11, 11, 16, 14], "text-letter-spacing": 0.06 },
      "paint": { "text-color": "#6f7d87", "text-halo-color": "#faf9f5", "text-halo-width": 1.4 } },

    { "id": "manga-road-label", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name", "minzoom": 14,
      "layout": { "symbol-placement": "line", "text-field": ["case", ["has", "name:nonlatin"], ["concat", ["get", "name:latin"], " ", ["get", "name:nonlatin"]], ["coalesce", ["get", "name_en"], ["get", "name"]]], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 14, 10, 20, 13], "text-letter-spacing": 0.02 },
      "paint": { "text-color": "#3a322c", "text-halo-color": "#faf9f5", "text-halo-width": 1.5 } },

    { "id": "manga-place-label", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "minzoom": 9,
      "layout": { "text-field": ["case", ["has", "name:nonlatin"], ["concat", ["get", "name:latin"], " ", ["get", "name:nonlatin"]], ["coalesce", ["get", "name_en"], ["get", "name"]]], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 9, 10, 14, 13, 18, 17], "text-transform": "uppercase", "text-letter-spacing": 0.12, "text-max-width": 9 },
      "paint": { "text-color": "#2b2320", "text-halo-color": "#faf9f5", "text-halo-width": 1.7 } }
  ]
}
